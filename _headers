# Security-Header für Netlify oder Cloudflare Pages (gleiches Format).
# Für nginx und Apache siehe README.md. Prüfen nach dem Livegang:
# https://securityheaders.com und https://observatory.mozilla.org
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://contact-form.kristian95.workers.dev; manifest-src 'self'; form-action 'self' https://contact-form.kristian95.workers.dev; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Skripte und Styles bei jedem Aufruf kurz gegen den Server prüfen (ETag), damit nach einem
# Update nie alte Dateien mit neuem HTML zusammentreffen. Schriften und Bilder ändern sich selten.
/assets/js/*
  Cache-Control: no-cache

/assets/css/*
  Cache-Control: no-cache

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=86400
